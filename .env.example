# ============================================================
# 部署环境变量模板
# 使用方法：复制本文件为 .env，填入真实值后执行 docker compose up -d
# 注意：.env 已被 .gitignore 忽略，不会被上传到 git 仓库
# ============================================================

# PostgreSQL 数据库密码（请改成强密码，勿用 root 等弱密码）
POSTGRES_PASSWORD=请改成强密码_例如_Pg2026!Xy9z

# JWT 签名密钥（请改成随机长字符串，可用命令生成：openssl rand -hex 32）
SECRET_KEY=请改成随机长字符串_例如_8f3a9b2c1d4e5f6a7b8c9d0e1f2a3b4c

# 允许访问后端的前端来源（手机通过公网IP访问，填 http://你的虚拟机IP）
# 方案A用 nginx 同源反代，此项主要为兼容性保留
CORS_ORIGINS=["http://52.231.65.205"]
